NODE_ENV=development
PORT=8080
DATA_DIR=.data
SQLITE_DB_FILE=sysml-studio.db
JWT_SECRET=replace-me-local-dev
API_KEY_ENCRYPTION_SECRET=replace-with-32-byte-secret
SESSION_DAYS=7
REFRESH_SESSION_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
EMAIL_PROVIDER=dev
EMAIL_FROM=SysML Studio <no-reply@example.com>
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTGRES_USER=sysml
POSTGRES_PASSWORD=sysml
POSTGRES_DB=sysml
DATABASE_URL=postgres://sysml:sysml@postgres:5432/sysml
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379
OBJECT_STORAGE_PATH=/data/exports
DEFAULT_AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
