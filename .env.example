# Runtime
NODE_ENV=development
PORT=8080
DATA_DIR=.data
SQLITE_DB_FILE=sysml-studio.db

# Use a long, random server secret in production. It encrypts tenant OpenAI keys.
API_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-production-secret

# Server-backed authentication sessions and rate limiting
SESSION_DAYS=7
REFRESH_SESSION_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Email: dev, resend, or sendgrid
EMAIL_PROVIDER=dev
EMAIL_FROM="SysML Studio <no-reply@example.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# AI: local requires no external service; ollama uses the settings below.
# OpenAI keys are configured per tenant in the application's AI Settings panel.
DEFAULT_AI_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
